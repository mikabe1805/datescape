# Memory Stress Profile - Tests memory usage patterns
# Many clients with frequent profiling for detailed memory analysis

CLIENTS=300
DURATION_SEC=600
SEND_MIN_MS=3000
SEND_MAX_MS=6000
MATCH_COUNT=30
DELIVERY_TIMEOUT_MS=20000

ENABLE_MESSAGE_SIZE_VARIANCE=true
ENABLE_MEMORY_PROFILING=true
MEMORY_PROFILE_INTERVAL_SEC=5

