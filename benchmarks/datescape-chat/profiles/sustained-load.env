# Sustained Load Profile - Long duration moderate load
# Tests stability over extended period (1 hour)

CLIENTS=100
DURATION_SEC=3600
SEND_MIN_MS=5000
SEND_MAX_MS=8000
MATCH_COUNT=20
DELIVERY_TIMEOUT_MS=20000

ENABLE_MESSAGE_SIZE_VARIANCE=true
ENABLE_MEMORY_PROFILING=true
MEMORY_PROFILE_INTERVAL_SEC=60

