{
  "rules": {
    ".read": false,
    ".write": false,

    "presence": {
      "$room": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['x','z','heading','speed','name','color']) && newData.child('name').isString() && newData.child('color').isString()"
        }
      }
    },

    "stations": {
      "$room": {
        ".read": "auth != null",
        "$stationId": {
          "seats": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid"
            }
          },
          "match": {
            ".write": "auth != null && (!data.exists() || data.child('white').val() === auth.uid || data.child('black').val() === auth.uid || newData.child('white').val() === auth.uid || newData.child('black').val() === auth.uid)",
            "moves": {
              "$moveKey": {
                ".write": "auth != null && newData.child('by').val() === auth.uid"
              }
            }
          }
        }
      }
    },

    "signals": {
      "$toUid": {
        ".read": "auth != null && auth.uid === $toUid",
        ".write": "auth != null",
        "$signalKey": {
          ".write": "auth != null && (auth.uid === $toUid || newData.child('fromUid').val() === auth.uid)"
        }
      }
    },

    "worldLikes": {
      "$fromUid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $fromUid"
      }
    }
  }
}
