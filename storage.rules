rules_version = '2';

// Cloud Storage rules. Tightens the default test mode that expires after 30 days.
service firebase.storage {
  match /b/{bucket}/o {
    // User-uploaded media for their own profile.
    // Path: userMedia/<uid>/...
    // - Read: any authenticated user (so other users can see profile pics in matches).
    // - Write: only the owner.
    match /userMedia/{uid}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 100 * 1024 * 1024
                   && (
                     request.resource.contentType.matches("image/.*")
                     || request.resource.contentType.matches("video/.*")
                   );
    }

    // Default deny everything else.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
