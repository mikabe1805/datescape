rules_version = '2';

// Cloud Storage rules. Tightens the default test mode that expires after 30 days.
service firebase.storage {
  match /b/{bucket}/o {
    function accountDeletionStarted(uid) {
      return firestore.exists(
        /databases/(default)/documents/deletingAccounts/$(uid)
      );
    }

    function isMatchParticipant(matchId) {
      let matchData = firestore.get(
        /databases/(default)/documents/matches/$(matchId)
      ).data;
      return request.auth != null
             && (request.auth.uid == matchData.userA
                 || request.auth.uid == matchData.userB);
    }

    function isActiveMatchParticipant(matchId) {
      let matchData = firestore.get(
        /databases/(default)/documents/matches/$(matchId)
      ).data;
      return request.auth != null
             && matchData.matched == true
             && !accountDeletionStarted(request.auth.uid)
             && !accountDeletionStarted(matchData.userA)
             && !accountDeletionStarted(matchData.userB)
             && (request.auth.uid == matchData.userA
                 || request.auth.uid == matchData.userB);
    }

    // User-uploaded media for their own profile.
    // Path: userMedia/<uid>/...
    // - Get: any authenticated user (so scoped match cards can load profile media).
    // - List: denied; clients cannot enumerate a user's media directory.
    // Legacy getDownloadURL values are durable bearer-token URLs and may bypass
    // Storage Rules until the object's token is rotated or the object is
    // deleted. This rule prevents SDK listing; it is not retroactive URL
    // revocation for URLs already copied into legacy match documents.
    // - Write: only the owner.
    match /userMedia/{uid}/{allPaths=**} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create, update: if request.auth != null
                            && request.auth.uid == uid
                            && !accountDeletionStarted(uid)
                            && request.resource.size < 100 * 1024 * 1024
                            && (
                              request.resource.contentType.matches("image/.*")
                              || request.resource.contentType.matches("video/.*")
                            );
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // New chat media paths bind the owner and preallocated message id. The
    // owner may remove an upload only while no corresponding message exists,
    // allowing failed sends to clean up without making sent history mutable.
    match /chatMedia/{matchId}/{ownerUid}/{messageId}/{fileName} {
      allow get: if isMatchParticipant(matchId);
      allow list: if false;
      allow create: if request.auth != null
                    && request.auth.uid == ownerUid
                    && isActiveMatchParticipant(matchId)
                    && request.resource.size > 0
                    && (
                      (
                        request.resource.size <= 15 * 1024 * 1024
                        && request.resource.contentType.matches(
                          "image/(jpeg|png|webp|gif)"
                        )
                      )
                      || (
                        request.resource.size <= 50 * 1024 * 1024
                        && request.resource.contentType.matches(
                          "video/(mp4|webm|quicktime)"
                        )
                      )
                      || (
                        request.resource.size <= 10 * 1024 * 1024
                        && request.resource.contentType.matches(
                          "audio/(webm|ogg|mpeg|mp4|wav|x-m4a)"
                        )
                      )
                    );
      allow update: if false;
      allow delete: if request.auth != null
                    && request.auth.uid == ownerUid
                    && !firestore.exists(
                      /databases/(default)/documents/matches/$(matchId)/messages/$(messageId)
                    );
    }

    // Legacy media remains readable to its pair for existing history, but new
    // objects cannot use the unowned legacy shape and directories cannot be
    // enumerated.
    match /chatMedia/{matchId}/{allPaths=**} {
      allow get: if isMatchParticipant(matchId);
      allow list: if false;
      allow create, update, delete: if false;
    }

    // Default deny everything else.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
